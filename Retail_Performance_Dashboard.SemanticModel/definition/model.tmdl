model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Dim_Date","Dim_Store","Dim_Category","Fact_KPI_Sales","Fact_Product_Sales","_Measures","SourceFolderPath"]

ref table Dim_Date
ref table Dim_Store
ref table Dim_Category
ref table Fact_KPI_Sales
ref table Fact_Product_Sales
ref table _Measures

ref cultureInfo en-US

