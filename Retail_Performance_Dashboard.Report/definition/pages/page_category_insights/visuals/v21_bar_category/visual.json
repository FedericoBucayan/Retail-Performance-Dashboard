{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "v21_bar_category",
  "position": {
    "x": 20,
    "y": 100,
    "z": 2000,
    "height": 380,
    "width": 600
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Category"
                    }
                  },
                  "Property": "Category"
                }
              },
              "queryRef": "Dim_Category.Category",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Product Net Sales"
                }
              },
              "queryRef": "_Measures.Product Net Sales"
            }
          ]
        }
      }
    }
  }
}