{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "v11_trend_chart",
  "position": {
    "x": 20,
    "y": 750,
    "z": 5000,
    "height": 600,
    "width": 1240
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Dim_Date.Month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Net Sales"
                }
              },
              "queryRef": "_Measures.Total Net Sales"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "NS PY"
                }
              },
              "queryRef": "_Measures.NS PY"
            }
          ]
        }
      }
    }
  }
}